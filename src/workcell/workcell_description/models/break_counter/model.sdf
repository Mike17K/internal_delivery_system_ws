<?xml version="1.0"?>

<sdf version="1.10">

  <model name="break_counter">

    <static>true</static>

    <link name="counter_link">

      <!-- ========================== -->
      <!-- COUNTER                     -->
      <!-- ========================== -->

      <collision name="counter_collision">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry>
          <box>
            <size>2.0 0.6 0.9</size>
          </box>
        </geometry>
      </collision>

      <visual name="counter_visual">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry>
          <box>
            <size>2.0 0.6 0.9</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>


      <!-- ========================== -->
      <!-- SINK BASIN (visual accent)  -->
      <!-- ========================== -->

      <visual name="sink_visual">
        <pose>0.6 0.05 0.91 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5 0.35 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.65 1</ambient>
          <diffuse>0.6 0.6 0.65 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>


      <!-- ========================== -->
      <!-- FRIDGE                      -->
      <!-- ========================== -->

      <collision name="fridge_collision">
        <pose>-1.35 0 0.9 0 0 0</pose>
        <geometry>
          <box>
            <size>0.7 0.7 1.8</size>
          </box>
        </geometry>
      </collision>

      <visual name="fridge_visual">
        <pose>-1.35 0 0.9 0 0 0</pose>
        <geometry>
          <box>
            <size>0.7 0.7 1.8</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

    </link>

  </model>

</sdf>
