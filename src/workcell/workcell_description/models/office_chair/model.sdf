<?xml version="1.0"?>

<sdf version="1.10">

  <model name="office_chair">

    <static>true</static>

    <link name="chair_link">

      <!-- ========================== -->
      <!-- SEAT                        -->
      <!-- ========================== -->

      <collision name="seat_collision">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry>
          <box>
            <size>0.45 0.45 0.05</size>
          </box>
        </geometry>
      </collision>

      <visual name="seat_visual">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry>
          <box>
            <size>0.45 0.45 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.2 1</ambient>
          <diffuse>0.15 0.15 0.2 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>


