<?xml version="1.0"?>

<model>
  <name>office_floor</name>
  <version>1.0</version>

  <sdf version="1.10">
    model.sdf
  </sdf>

  <author>
    <name>Workcell</name>
    <email>robotics@example.com</email>
  </author>

  <description>
    A full office floor: exterior/interior walls, a corridor flanked by
    individual offices, a meeting room, a break room, and a lobby, all
    furnished with the reusable office_desk/office_chair/office_cabinet/
    potted_plant/ceiling_light/reception_desk/meeting_table/break_counter
    models. Generated by scripts/generate_office_floor.py.
  </description>
</model>
