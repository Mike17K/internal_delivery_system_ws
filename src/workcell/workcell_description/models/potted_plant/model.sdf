<?xml version="1.0"?>

<sdf version="1.10">

  <model name="potted_plant">

    <static>true</static>

    <link name="plant_link">

      <!-- ========================== -->
      <!-- POT                         -->
      <!-- ========================== -->

      <collision name="pot_collision">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="pot_visual">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.27 0.15 1</ambient>
          <diffuse>0.55 0.27 0.15 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>


      <!-- ========================== -->
      <!-- FOLIAGE                     -->
      <!-- ========================== -->

      <collision name="foliage_collision">
        <pose>0 0 0.65 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.35</radius>
          </sphere>
        </geometry>
      </collision>

      <visual name="foliage_visual">
        <pose>0 0 0.65 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.35</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.15 0.45 0.2 1</ambient>
          <diffuse>0.15 0.45 0.2 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

    </link>

  </model>

</sdf>
