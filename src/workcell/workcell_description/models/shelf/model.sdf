<?xml version="1.0"?>

<sdf version="1.10">

  <model name="shelf">

    <static>false</static>

    <link name="shelf_link">

      <!-- ================================= -->
      <!-- BACK FRAME                         -->
      <!-- ================================= -->

      <visual name="back_visual">

        <pose>0 0.45 1.5 0 0 0</pose>

        <geometry>
          <box>
            <size>2.5 0.1 3.0</size>
          </box>
          <!-- <mesh>
            <uri>
              model://shelf/meshes/shelf_visual.dae
            </uri>
          </mesh> -->
        </geometry>

      </visual>

      <collision name="back_collision">

        <pose>0 0.45 1.5 0 0 0</pose>

        <geometry>
          <box>
            <size>2.5 0.1 3.0</size>
          </box>
        </geometry>

      </collision>


      <!-- ================================= -->
      <!-- SHELF 1                            -->
      <!-- ================================= -->

      <visual name="shelf_1_visual">

        <pose>0 0 0.5 0 0 0</pose>

        <geometry>
          <box>
            <size>2.5 0.8 0.1</size>
          </box>
        </geometry>

      </visual>

      <collision name="shelf_1_collision">

        <pose>0 0 0.5 0 0 0</pose>

        <geometry>
          <box>
            <size>2.5 0.8 0.1</size>
          </box>
        </geometry>

      </collision>


      <!-- ================================= -->
      <!-- SHELF 2                            -->
      <!-- ================================= -->

      <visual name="shelf_2_visual">

        <pose>0 0 1.5 0 0 0</pose>

        <geometry>
          <box>
            <size>2.5 0.8 0.1</size>
          </box>
        </geometry>

      </visual>

      <collision name="shelf_2_collision">

        <pose>0 0 1.5 0 0 0</pose>

        <geometry>
          <box>
            <size>2.5 0.8 0.1</size>
          </box>
        </geometry>

      </collision>


      <!-- ================================= -->
      <!-- SHELF 3                            -->
      <!-- ================================= -->

      <visual name="shelf_3_visual">

        <pose>0 0 2.5 0 0 0</pose>

        <geometry>
          <box>
            <size>2.5 0.8 0.1</size>
          </box>
        </geometry>

      </visual>

      <collision name="shelf_3_collision">

        <pose>0 0 2.5 0 0 0</pose>

        <geometry>
          <box>
            <size>2.5 0.8 0.1</size>
          </box>
        </geometry>

      </collision>


      <!-- ================================= -->
      <!-- LEFT POST                          -->
      <!-- ================================= -->

      <visual name="left_post_visual">

        <pose>-1.15 0 1.5 0 0 0</pose>

        <geometry>
          <box>
            <size>0.1 0.1 3.0</size>
          </box>
        </geometry>

      </visual>

      <collision name="left_post_collision">

        <pose>-1.15 0 1.5 0 0 0</pose>

        <geometry>
          <box>
            <size>0.1 0.1 3.0</size>
          </box>
        </geometry>

      </collision>


      <!-- ================================= -->
      <!-- RIGHT POST                         -->
      <!-- ================================= -->

      <visual name="right_post_visual">

        <pose>1.15 0 1.5 0 0 0</pose>

        <geometry>
          <box>
            <size>0.1 0.1 3.0</size>
          </box>
        </geometry>

      </visual>

      <collision name="right_post_collision">

        <pose>1.15 0 1.5 0 0 0</pose>

        <geometry>
          <box>
            <size>0.1 0.1 3.0</size>
          </box>
        </geometry>

      </collision>

    </link>

  </model>

</sdf>